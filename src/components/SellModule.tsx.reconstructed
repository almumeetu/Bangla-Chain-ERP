}

// ── Totals Calculation Helper (Dynamic UOM Price Overrides) ──
export function getCartItemTotals(item: CartItem) {
  const netQty = Math.max(0, item.baseQty - (item.returnedQty || 0) - (item.damagedQty || 0));
  
  const list: { name: string; multiplier: number }[] = [{ name: 'Pcs', multiplier: 1 }];
  if (item.product.customUnits) {
    for (const cu of item.product.customUnits) {
      if (!list.some(x => x.name.toLowerCase() === cu.name.toLowerCase())) {
        list.push({ name: cu.name, multiplier: cu.multiplier });
      }
      if (cu.secondaryUnitName && cu.secondaryMultiplier && cu.secondaryMultiplier > 0) {
        const secMult = cu.multiplier / cu.secondaryMultiplier;
        if (!list.some(x => x.name.toLowerCase() === cu.secondaryUnitName!.toLowerCase())) {
          list.push({ name: cu.secondaryUnitName, multiplier: secMult });
        }
      }
    }
  }
  const selectedUnit = list.find(u => u.name === item.selectedUnitName) || { name: 'Pcs', multiplier: 1 };
  const selectedMultiplier = selectedUnit.multiplier;

  let unitDP = item.product.defaultPP * selectedMultiplier;
  let unitTP = item.product.defaultWSP * selectedMultiplier;

  if (selectedUnit.name !== 'Pcs') {
    const directUom = item.product.customUnits?.find(u => u.name === selectedUnit.name);
    if (directUom) {
      if (directUom.customDP !== undefined) unitDP = directUom.customDP;
      if (directUom.customTP !== undefined) unitTP = directUom.customTP;
    } else {
      const parentUom = item.product.customUnits?.find(u => u.secondaryUnitName === selectedUnit.name);
      if (parentUom && parentUom.secondaryMultiplier && parentUom.secondaryMultiplier > 0) {
        const parentDP = parentUom.customDP !== undefined ? parentUom.customDP : item.product.defaultPP * parentUom.multiplier;
        const parentTP = parentUom.customTP !== undefined ? parentUom.customTP : item.product.defaultWSP * parentUom.multiplier;
        unitDP = parentDP / parentUom.secondaryMultiplier;
        unitTP = parentTP / parentUom.secondaryMultiplier;
      }
    }
  }

  const qtyInSelectedUnit = netQty / selectedMultiplier;

  return {
    unitDP,
    unitTP,
    selectedMultiplier,
    totalDP: unitDP * qtyInSelectedUnit,
    totalTP: unitTP * qtyInSelectedUnit
  };
}

// ── UnitDisplay Component (Reusable)
function UnitDisplay({ qty, units, textSize = "[11px]" }: { qty: number, units: UnitOfMeasure[], textSize?: string }) {
  const sortedUnits = [...units].sort((a, b) => a.multiplier - b.multiplier);
  return (
    <div className="font-mono space-y-0.5">
      {sortedUnits.map(unit => {
        const unitQty = qty / unit.multiplier;
        const qtyStr = Number.isInteger(unitQty)
          ? unitQty.toLocaleString()
          : unitQty.toFixed(1);
        return (
          <div key={unit.id} className={`text-${textSize}`}>
            {qtyStr} {unit.symbol || unit.name}
          </div>
        );
      })}
    </div>
  );
}

