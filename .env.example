# ============================================================
# Bangla-Chain ERP — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

# Public anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service role key (SERVER-SIDE ONLY — never expose to browser!)
# Used by API routes to bypass RLS for admin operations.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ── SR Authentication ─────────────────────────────────────────────────────────
# A random 64+ character secret for signing SR JWT tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SR_JWT_SECRET=change-me-to-a-random-64-character-secret-string-please-change-this

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at https://resend.com to get an API key.

# Your Resend API key
RESEND_API_KEY=re_your_resend_api_key_here

# The "From" email address. Must be a verified domain on Resend.
# For testing with Resend sandbox: onboarding@resend.dev
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Optional: Override the recipient email (useful for development/testing)
# When set, ALL emails will be sent to this address regardless of customer email.
# Remove this variable in production.
# RESEND_TO_EMAIL=developer@yourdomain.com

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Optional: Analytics ───────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
