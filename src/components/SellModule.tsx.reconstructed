              const multiplier = primaryUnit ? primaryUnit.multiplier : 1;
              const unitName = primaryUnit ? primaryUnit.name : 'Pcs';
              const qtyInUnit = product.currentStock / multiplier;
              return (
                <>
                  <div className="text-[9px] font-mono font-black text-slate-700">
